{
  "name": "tradelog",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:android-apk": "node scripts/build-android-apk.mjs",
    "build:android-bundle": "npm run build:android-apk",
    "build:web": "expo export --platform web && node scripts/prepare-pwa-output.mjs && node scripts/web-config-output-smoke.mjs && node scripts/pwa-smoke.mjs && node scripts/service-worker-offline-smoke.mjs",
    "test:app-config": "node --import tsx scripts/app-config-read-smoke.ts",
    "test:backup": "node --import tsx scripts/backup-roundtrip-smoke.ts",
    "test:android-apk": "node scripts/android-apk-smoke.mjs",
    "test:pwa": "node scripts/pwa-smoke.mjs",
    "test:pwa-offline": "node scripts/service-worker-offline-smoke.mjs",
    "test:web-db": "node --import tsx scripts/web-db-smoke.ts",
    "test:accounts": "node --import tsx scripts/accounts-web-smoke.ts",
    "security:check": "node scripts/security-smoke.mjs",
    "test:android-pipeline": "node scripts/android-pipeline-smoke.mjs",
    "check": "npm run security:check && npm run typecheck && npm run test:web-db && npm run test:accounts && npm run test:backup && npm run test:app-config && npm run test:android-pipeline && npm run build:web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.6",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.7",
    "@react-navigation/native": "^7.3.7",
    "@react-navigation/native-stack": "^7.17.9",
    "check": "^1.0.0",
    "dexie": "^4.4.4",
    "expo": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.0",
    "expo-image-picker": "~57.0.2",
    "expo-notifications": "~57.0.3",
    "expo-print": "~57.0.0",
    "expo-sharing": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.0",
    "i18next": "^26.3.4",
    "npm": "^12.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.8",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.0",
    "run": "^1.5.0",
    "victory-native": "^36.9.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.7",
    "babel-preset-expo": "~57.0.1",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  }
}
