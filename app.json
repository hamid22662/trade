{
  "expo": {
    "name": "TradeLog",
    "slug": "tradelog",
    "version": "1.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "backgroundColor": "#0A1633",
    "android": {
      "package": "com.tradelog.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1633"
      },
      "versionCode": 2
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "TradeLog needs access to chart screenshots so your journal remains complete."
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": false
        }
      ],
      "expo-font"
    ],
    "scheme": "tradelog",
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "TradeLog",
      "shortName": "TradeLog",
      "lang": "fa",
      "description": "ژورنال آفلاین و خصوصی معاملات فارکس و کریپتو",
      "favicon": "./public/favicon.png",
      "themeColor": "#0A1633",
      "backgroundColor": "#0A1633",
      "display": "standalone"
    }
  }
}
